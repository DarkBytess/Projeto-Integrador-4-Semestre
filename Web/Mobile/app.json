{
  "expo": {
    "name": "AgroMonitor",
    "slug": "agromonitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agromonitor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.senai.agromonitor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16A34A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.senai.agromonitor"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "AgroMonitor",
      "shortName": "AgroMonitor",
      "description": "Sistema de monitoramento agrícola em tempo real",
      "themeColor": "#16A34A",
      "backgroundColor": "#F8FAFC",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16A34A",
          "dark": {
            "backgroundColor": "#14532D"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
